# Скопируйте в .env и заполните. .env в git не попадает.
DB_PASSWORD=onestep
# порт PostgreSQL на хосте (5432 часто занят локальным Postgres)
DB_PORT=5433

# none | gigachat | yandexgpt  (none = только детерминированный разбор запроса)
LLM_PROVIDER=none

# GigaChat: ключ авторизации (Base64 client_id:client_secret) из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YandexGPT: API-ключ сервисного аккаунта и folder id из Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
